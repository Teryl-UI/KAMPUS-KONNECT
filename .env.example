# Campus Connect - Environment Variables Example
# Copy this file to .env.local and populate the values

# Gemma / Google AI Studio API Key (Get yours at https://aistudio.google.com/)
GEMMA_API_KEY=your_gemma_api_key_here

# Gemma model to use (default: gemma-4-26b-a4b-it, or gemma-2-9b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: Custom Hosted Inference Endpoint (OpenAI-compatible or custom proxy)
# GEMMA_BASE_URL=https://api.example.com/v1

