# ==========================================
# Kampus Konnect — .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js Build & Distribution Output
/.next/
/out/
/build/
/dist/

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# Environment Variables & Secret Files
# CRITICAL: Never commit API keys, secrets, or private credentials!
.env
.env*.local
.env.production
.env.development
.env.test

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.pfx
*.pkcs12
id_rsa*
*.credentials

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Temporary & Cache Files
*.tmp
*.temp
*.bak
*.cache
~*

# Vercel Deployment Metadata
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
